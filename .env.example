# Database
DATABASE_URL=postgresql+asyncpg://meetscribe:Birdsey5%40@db:5432/meetscribe
REDIS_URL=redis://redis:6379/0

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=2
AUDIO_CHUNK_SECONDS=30
RECORDINGS_PATH=/data/recordings

# AI/ML
WHISPER_MODEL=medium
WHISPER_COMPUTE_TYPE=float16
WHISPER_BATCH_SIZE=8
HF_TOKEN=  # Required for pyannote diarization - get from https://huggingface.co/settings/tokens
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Calendar (Optional - Phase 5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
CALENDAR_SYNC_INTERVAL_MINUTES=5

# Security (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=  # 32-byte base64-encoded Fernet key
SECRET_KEY=  # Random string for FastAPI/JWT

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
